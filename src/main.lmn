<root padding="28" gap="16" bg="#0c1c30">
  <label class="title" height="40px" text="Todo" />
  <row gap="10">
    <input id="draft" class="field" height="40px" grow="1" bind-text="draft" placeholder="What needs doing?" tab-index="0" />
    <button id="add" class="primary" width="96px" height="40px" text="Add" />
  </row>
  <label class="caption" height="22px" text="" bind-text="left_label" />
  <scroll gap="0" grow="1">
    <for gap="6" each="todos" key="id">
      <row class="todo-row" height="44px" gap="10" align="center">
        <button id="tg|{row.id}" class="check {row.check_cls}" width="30px" height="30px" text="{row.mark}" />
        <label class="{row.label_cls}" grow="1" text="{row.label}" max-lines="1" wrap="none" />
        <button id="rm|{row.id}" class="remove" width="34px" height="30px" text="x" />
      </row>
    </for>
  </scroll>
  <row gap="10">
    <button id="clear-done" class="ghost" width="140px" height="36px" text="Clear done" />
  </row>
  <script src="main.cdl" />
</root>
