import "lumen.cdl";

// Rows live in the "todos" array signal; `<for each="todos" key="id">`
// reconciles the list on every write. Presentation fields (mark, check_cls,
// label_cls) are computed here so the markup stays dumb.

// One row record. A candela map literal holds one value type, so every field
// is a string; `<for>` binds them by name. A row read back out of the signal
// is a `{any: any}`, so a row built here is widened with `as {any: any}`
// wherever the two meet in one list.
fn make_row(id, label, done) {
    let row = {"id": id, "label": label, "done": done};
    if done == "true" {
        row["mark"] = "X";
        row["check_cls"] = "check-on";
        row["label_cls"] = "todo-label-done";
    } else {
        row["mark"] = "";
        row["check_cls"] = "";
        row["label_cls"] = "todo-label";
    }
    return row;
}

// Every edit ends here: publish the rows, then refresh the count line.
fn write_rows(rows) {
    let todos = signal_array("todos");
    todos.set(rows);
    let left = 0;
    for r in rows {
        let done = r["done"] as string;
        if done != "true" { left = left + 1; }
    }
    let total = rows.len();
    let count = string(left) + " open / " + string(total) + " total";
    signal<string>("left_label").set(count);
}

// The current rows, as plain maps. `all()` hands back `any`, so the list and
// each record are read through the `as any[]` / `as {any: any}` downcasts.
fn current_rows() {
    let todos = signal_array("todos");
    let raw = todos.all() as any[];
    let out = [];
    for item in raw {
        out.push(item as {any: any});
    }
    return out;
}

fn on_start() {
    lumen::on("click", "add", "add_todo");
    lumen::on("click", "clear-done", "clear_done");
    signal<int>("next_id").set(4);

    let rows = [];
    rows.push(make_row("1", "Scaffold this app", "true") as {any: any});
    rows.push(make_row("2", "Read the todo README", "false") as {any: any});
    rows.push(make_row("3", "Build something reactive", "false") as {any: any});
    write_rows(rows);
}

fn add_todo(id: string) {
    let draft = signal<string>("draft").get();
    if draft == "" { return; }
    let next = signal<int>("next_id");
    let n = next.get();
    let rows = current_rows();
    rows.push(make_row(string(n), draft, "false") as {any: any});
    next.set(n + 1);
    signal<string>("draft").set("");
    write_rows(rows);
}

// candela has no closure value, so a filter is an explicit loop.
fn clear_done(id: string) {
    let kept = [];
    let rows = current_rows();
    for r in rows {
        let done = r["done"] as string;
        if done != "true" { kept.push(r); }
    }
    write_rows(kept);
}

// Per-row buttons carry interpolated ids ("tg|<id>", "rm|<id>"); the global
// on_click fallback splits the prefix off.
fn on_click(id: string) {
    let parts = id.split("|");
    if parts.len() != 2 { return; }
    let kind = parts[0];
    let tid = parts[1];
    if kind == "tg" { toggle_todo(tid); }
    if kind == "rm" { remove_todo(tid); }
}

fn toggle_todo(tid) {
    let out = [];
    let rows = current_rows();
    for r in rows {
        let rid = r["id"] as string;
        if rid != tid {
            out.push(r);
        } else {
            let done = r["done"] as string;
            let label = r["label"] as string;
            let flipped = "true";
            if done == "true" { flipped = "false"; }
            out.push(make_row(rid, label, flipped) as {any: any});
        }
    }
    write_rows(out);
}

fn remove_todo(tid) {
    let kept = [];
    let rows = current_rows();
    for r in rows {
        let rid = r["id"] as string;
        if rid != tid { kept.push(r); }
    }
    write_rows(kept);
}

fn main() {}
